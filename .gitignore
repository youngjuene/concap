.env
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.py[cod]

# Large or generated experiment artifacts (repo root only — src/dpo/data
# and tests/data are source directories and must stay tracked)
/artifacts/
/data/
/runs/
/wandb/

# Machine-local tool state
.claude/settings.local.json
# uv writes this; pyproject's requires-python is the authoritative pin and the
# per-run receipts record the exact interpreter, so this would only add a third,
# coarser copy that can disagree with both.
.python-version
